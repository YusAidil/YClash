[Unit]
Description=Clash of Clans Upgrade Tracker
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/coc-tracker
Environment=HOST=127.0.0.1
Environment=PORT=3100
EnvironmentFile=/home/ubuntu/coc-tracker/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/coc-tracker/data

[Install]
WantedBy=multi-user.target